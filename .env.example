VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set this to the canonical production URL (https://activeburger.com); leave blank locally.
VITE_AUTH_REDIRECT_URL=
VITE_TEST_USER_EMAIL=
VITE_TEST_USER_PASSWORD=# "production" or "dev"; shown in the header when dev. Left blank, a hosted build
# follows Netlify's deploy context and a local one follows its Vite mode.
VITE_APP_ENVIRONMENT=
